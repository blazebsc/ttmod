{
  "version": 6,
  "cmakeMinimumRequired": { "major": 3, "minor": 20, "patch": 0 },
  "configurePresets": [
    {
      "name": "linux-debug",
      "displayName": "Linux native (tests + CLI)",
      "generator": "Unix Makefiles",
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" }
    },
    {
      "name": "linux-release",
      "displayName": "Linux native, optimized",
      "generator": "Unix Makefiles",
      "binaryDir": "${sourceDir}/build-release",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" }
    },
    {
      "name": "win32-mingw",
      "displayName": "Windows x86 runtime (game DLLs)",
      "generator": "Unix Makefiles",
      "binaryDir": "${sourceDir}/build-win32",
      "toolchainFile": "${sourceDir}/cmake/mingw-i686.cmake",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "TTMOD_BUILD_WIN_RUNTIME": "ON"
      }
    },
    {
      "name": "linux-asan",
      "displayName": "Linux native + AddressSanitizer",
      "generator": "Unix Makefiles",
      "binaryDir": "${sourceDir}/build-asan",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "TTMOD_ENABLE_ASAN": "ON"
      }
    },
    {
      "name": "linux-ubsan",
      "displayName": "Linux native + UBSan",
      "generator": "Unix Makefiles",
      "binaryDir": "${sourceDir}/build-ubsan",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "TTMOD_ENABLE_UBSAN": "ON"
      }
    },
    {
      "name": "linux-fuzz",
      "displayName": "libFuzzer harnesses (Clang)",
      "generator": "Unix Makefiles",
      "binaryDir": "${sourceDir}/build-fuzz",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_CXX_COMPILER": "clang++",
        "CMAKE_C_COMPILER": "clang",
        "TTMOD_BUILD_FUZZ": "ON"
      }
    }
  ],
  "buildPresets": [
    { "name": "linux-debug", "configurePreset": "linux-debug" },
    { "name": "linux-release", "configurePreset": "linux-release" },
    { "name": "win32-mingw", "configurePreset": "win32-mingw" },
    { "name": "linux-asan", "configurePreset": "linux-asan" },
    { "name": "linux-ubsan", "configurePreset": "linux-ubsan" },
    { "name": "linux-fuzz", "configurePreset": "linux-fuzz" }
  ],
  "testPresets": [
    { "name": "linux-debug", "configurePreset": "linux-debug" },
    { "name": "linux-asan", "configurePreset": "linux-asan" },
    { "name": "linux-ubsan", "configurePreset": "linux-ubsan" }
  ]
}
